#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DESKTOP="$ROOT/apps/desktop"
RESOLVED="$DESKTOP/Package.resolved"
LICENSE_FILE="$DESKTOP/.build/checkouts/GRDB.swift/LICENSE"
EXPECTED_LICENSE_SHA256="9853f9dce81365fcc1d9b46004633354450164b8d17904e92e80c444545f7e87"

[[ -f "$RESOLVED" ]] || { echo "FAIL: Swift Package.resolved is missing" >&2; exit 1; }
[[ -f "$LICENSE_FILE" ]] || { echo "FAIL: GRDB checkout license is missing; resolve the package first" >&2; exit 1; }

node - "$RESOLVED" <<'NODE'
const fs = require("node:fs");
const resolved = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
const pins = resolved.pins ?? [];
if (pins.length !== 1) throw new Error(`expected one Swift pin, found ${pins.length}`);
const pin = pins[0];
if (pin.identity !== "grdb.swift" || pin.state?.version !== "7.11.1") {
  throw new Error("GRDB must be resolved exactly at 7.11.1");
}
if (pin.state?.revision !== "b83108d10f42680d78f23fe4d4d80fc88dab3212") {
  throw new Error("GRDB 7.11.1 revision does not match reviewed evidence");
}
NODE

GRAPH="$(cd "$DESKTOP" && swift package --disable-sandbox show-dependencies --format json 2>/dev/null)"
printf '%s' "$GRAPH" | node -e '
const fs = require("node:fs");
const root = JSON.parse(fs.readFileSync(0, "utf8"));
if (root.dependencies.length !== 1) throw new Error("unexpected Swift dependency count");
const grdb = root.dependencies[0];
if (grdb.identity !== "grdb.swift" || grdb.version !== "7.11.1") {
  throw new Error("unexpected Swift dependency identity or version");
}
if ((grdb.dependencies ?? []).length !== 0) {
  throw new Error("GRDB default product unexpectedly resolved transitive packages");
}
'

ACTUAL_LICENSE_SHA256="$(shasum -a 256 "$LICENSE_FILE" | awk '{print $1}')"
[[ "$ACTUAL_LICENSE_SHA256" == "$EXPECTED_LICENSE_SHA256" ]] || {
  echo "FAIL: GRDB MIT notice hash changed" >&2
  exit 1
}
grep -Fq "Permission is hereby granted, free of charge" "$LICENSE_FILE"
grep -Fq "Copyright (C) 2015-2025 Gwendal Roué" "$LICENSE_FILE"
if grep -Eiq 'AGPL|GNU GENERAL PUBLIC LICENSE|non-commercial|UNKNOWN' "$LICENSE_FILE"; then
  echo "FAIL: prohibited or unknown Swift license marker" >&2
  exit 1
fi

printf '%s\n' "swift-licenses: OK — GRDB 7.11.1 exact, MIT notice verified, zero resolved transitive packages"
