#!/usr/bin/env bash
# LinkDigest read-only project health check. It reports problems but never fixes files.
set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)" || {
  echo "FAIL: cannot resolve project root" >&2
  exit 1
}
cd "$ROOT" || exit 1

PASS=0
WARN=0
FAIL=0

section() { printf '\n=== %s ===\n' "$*"; }
ok() { echo "OK: $*"; PASS=$((PASS + 1)); }
warn() { echo "WARN: $*"; WARN=$((WARN + 1)); }
fail() { echo "FAIL: $*" >&2; FAIL=$((FAIL + 1)); }

require_file() {
  if [ -f "$1" ]; then ok "$1 exists"; else fail "missing $1"; fi
}

run_check() {
  local label="$1"
  shift
  local output
  if output="$("$@" 2>&1)"; then
    ok "$label"
    [ -z "$output" ] || printf '%s\n' "$output"
  else
    fail "$label"
    [ -z "$output" ] || printf '%s\n' "$output" >&2
  fi
}

section "1. Entrypoints"
for command in git node pnpm rg; do
  if command -v "$command" >/dev/null 2>&1; then ok "$command available"; else fail "missing runtime: $command"; fi
done
for file in README.md AGENTS.md BRAIN.md VERIFY.md package.json pnpm-workspace.yaml \
  pnpm-lock.yaml tsconfig.base.json eslint.config.mjs .github/workflows/ci.yml \
  docs/PRD.md docs/ARCHITECTURE.md docs/CAPACITY_MODEL.md \
  docs/specs/V0.1_VERTICAL_SLICE.md docs/specs/V0.2_BYOK_ACCEPTANCE.md \
  docs/DEPENDENCIES.md docs/ACCEPTANCE_GUIDE.md \
  config/native-host.json config/native-host-release-policy.json config/app-release.json config/local-test-release.json docs/specs/P0_RC_LOOP_4_STABLE_HOST.md docs/specs/P0_RC_LOOP_4_R2_TRANSACTIONS.md docs/specs/P0_RC_LOOP_4_R3_PREFLIGHT.md docs/specs/P0_RC_LOOP_4_R4A_RELEASE_UNIT.md docs/specs/P0_RC_LOOP_4_R4B_LOCAL_TEST_DMG.md \
  packages/shared/package.json packages/shared/tsconfig.json; do
  require_file "$file"
done
for file in scripts/brain scripts/check-brain-root scripts/check-licenses scripts/check-contract-sync.sh scripts/check-v02-secret-hygiene.sh scripts/check-release-test-seams.sh scripts/doctor \
  scripts/build-release.sh scripts/native-host/check-config-sync.sh scripts/native-host/check-stable-package.sh \
  scripts/native-host/verify-stable-package.sh scripts/native-host/render-manifest.sh scripts/native-host/clean-room-install.sh \
  scripts/native-host/clean-room-transaction.sh scripts/native-host/check-transaction-host.sh \
  scripts/native-host/release_preflight.py scripts/native-host/release_preflight_check.py scripts/native-host/check-release-preflight.sh \
  scripts/native-host/release_unit.py scripts/native-host/release_unit_check.py scripts/native-host/package-app-dmg.sh scripts/native-host/check-release-unit.sh \
  scripts/native-host/local_test_release.py scripts/native-host/local_test_release_check.py scripts/native-host/package-local-test-dmg.sh scripts/native-host/check-local-test-release.sh; do
  if [ ! -f "$file" ]; then
    fail "missing $file"
  elif [ ! -x "$file" ]; then
    fail "$file is not executable"
  else
    ok "$file executable"
  fi
done

section "2. Project Brain"
run_check "canonical Brain root" ./scripts/check-brain-root
run_check "Brain links" ./scripts/brain lint-links
run_check "Swift and TypeScript contract copies stay synchronized" ./scripts/check-contract-sync.sh
run_check "stable Native Host canonical config stays synchronized" ./scripts/native-host/check-config-sync.sh
run_check "release preflight sources parse without build/install" python3 -c "import ast, pathlib; [ast.parse(pathlib.Path(name).read_text(encoding='utf-8')) for name in ('scripts/native-host/release_preflight.py', 'scripts/native-host/release_preflight_check.py')]"
run_check "r4a release-unit sources parse without build/mount" python3 -c "import ast, pathlib; [ast.parse(pathlib.Path(name).read_text(encoding='utf-8')) for name in ('scripts/native-host/release_unit.py', 'scripts/native-host/release_unit_check.py')]"
run_check "r4a app release config is strict" env PYTHONDONTWRITEBYTECODE=1 python3 scripts/native-host/release_unit.py check-config
run_check "r4b local-test config and r4a compatibility hashes are strict" env PYTHONDONTWRITEBYTECODE=1 python3 scripts/native-host/local_test_release.py check-config
if page_list="$(./scripts/brain list-pages 2>/dev/null)" && [ -n "$page_list" ]; then
  ok "Brain contains decision pages"
  active_count="$(printf '%s\n' "$page_list" | grep -c $'\tactive$' || true)"
  if [ "$active_count" -le 15 ]; then ok "active Brain pages stay focused ($active_count)"; else warn "active Brain pages exceed 15 ($active_count)"; fi
else
  fail "Brain has no decision pages"
fi

section "3. Documents and project rules"
run_check "package.json parses" node -e "JSON.parse(require('fs').readFileSync('package.json','utf8'))"
for required in \
  'SwiftUI' 'AppKit' 'Native Messaging' '版本化 JSON' 'cloud-deferred' \
  '远期参考'; do
  if rg -Fq "$required" AGENTS.md docs/PRD.md docs/ARCHITECTURE.md docs/CAPACITY_MODEL.md; then
    ok "documented: $required"
  else
    fail "missing required project concept: $required"
  fi
done
for required in '标准开发流程' '简单任务' '普通开发' '高风险任务' '风险相称'; do
  if rg -Fq "$required" AGENTS.md; then
    ok "development rule documented: $required"
  else
    fail "missing development rule: $required"
  fi
done

section "4. Sensitive-data boundary"
secret_pattern='-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY|sk-(proj-)?[A-Za-z0-9_-]{32,}|gh[pousr]_[A-Za-z0-9]{20,}'
if matches="$(rg -l --hidden \
  -g '!.git/**' \
  -g '!.scatter/**' \
  -g '!node_modules/**' \
  -g '!**/.build/**' \
  -g '!**/.output/**' \
  -g '!**/DerivedData/**' \
  "$secret_pattern" . 2>/dev/null)" && [ -n "$matches" ]; then
  fail "possible secret patterns found in paths below"
  printf '%s\n' "$matches" >&2
else
  ok "no high-confidence secret patterns"
fi

run_check "dependency licenses" ./scripts/check-licenses
run_check "V0.2 secret hygiene (read-only, blocking)" ./scripts/check-v02-secret-hygiene.sh
run_check "Release LinkDigestApp excludes test-only transport seams" ./scripts/check-release-test-seams.sh
dangerous_files="$(find . -path './.git' -prune -o -path './.scatter' -prune -o -type f -name '.env*' ! -name '.env.example' -print)"
if [ -n "$dangerous_files" ]; then
  fail "dangerous credential filenames found"
  printf '%s\n' "$dangerous_files" >&2
else
  ok "no dangerous credential filenames"
fi

section "5. Git baseline"
if git rev-parse --verify HEAD >/dev/null 2>&1; then
  ok "Git baseline exists"
else
  warn "repository has no first commit; commit still requires Syc approval"
fi
if [ -n "$(git status --porcelain)" ]; then
  warn "working tree has uncommitted files; doctor remains read-only"
else
  ok "working tree clean"
fi

section "Summary"
echo "PASS=$PASS WARN=$WARN FAIL=$FAIL"
if [ "$FAIL" -gt 0 ]; then
  echo "doctor: FAILED" >&2
  exit 1
elif [ "$WARN" -gt 0 ]; then
  echo "doctor: OK WITH WARNINGS"
else
  echo "doctor: OK"
fi
